FROM alpine:3.24.2

ENV TZ=UTC \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install runtime dependencies and development tools
RUN apk add --no-cache python3 py3-pip tzdata

COPY requirements.txt torrent-controller-bot.py bot_settings.py config.py logger.py message_queue.py name_parser.py /app/
COPY torrent_clients /app/torrent_clients
COPY locale /app/locale

# Install application and development dependencies
RUN export PIP_BREAK_SYSTEM_PACKAGES=1 && \
    pip3 install --no-cache-dir -Ur /app/requirements.txt && \
    pip3 install --no-cache-dir debugpy watchdog[watchmedo]

# Health check: unhealthy when Telegram has not answered a poll for 2 minutes
# (the bot touches the file on every poll, see HEARTBEAT_PATH in config.py)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import os, sys, time; sys.exit(time.time() - os.path.getmtime('/tmp/torrent-controller-bot.heartbeat') > 120)"

# Use watchdog for file monitoring
ENTRYPOINT ["watchmedo", "auto-restart", "-d", "/app", "-p", "*.py", "--", "python3", "torrent-controller-bot.py"]
